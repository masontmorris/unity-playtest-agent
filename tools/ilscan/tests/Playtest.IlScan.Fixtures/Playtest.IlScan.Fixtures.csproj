<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The assembly the tests scan. It targets .NET Standard with Unity's C# version, like a Unity script
    assembly, so the same file loads under live reflection on .NET, under Unity's Mono, and for
    inspection only.
  -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <AssemblyName>Playtest.IlScan.Fixtures</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Playtest.IlScan.Fixtures.Dependency/Playtest.IlScan.Fixtures.Dependency.csproj" />
  </ItemGroup>

</Project>
