    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <AssemblyName>Playtest.IlScan.Fixtures.Dependency</AssemblyName>
  </PropertyGroup>

</Project>
