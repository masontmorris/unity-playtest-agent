{
  "$defs": {
    "ActionCalibration": {
      "additionalProperties": false,
      "properties": {
        "bindings": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Bindings",
          "type": "array"
        },
        "control": {
          "minLength": 1,
          "title": "Control",
          "type": "string"
        },
        "control_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Physical root control name, without a device prefix",
          "title": "Control Name"
        },
        "control_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Declared Input System control type, e.g. Button, Axis or Stick",
          "title": "Control Type"
        },
        "dead_zone": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Dead Zone"
        },
        "dead_zone_reason": {
          "title": "Dead Zone Reason",
          "type": "string"
        },
        "declared_x": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": -1,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Declared normalized value measured for this control",
          "title": "Declared X"
        },
        "declared_y": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": -1,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Declared second value measured for this control",
          "title": "Declared Y"
        },
        "device": {
          "anyOf": [
            {
              "enum": [
                "Keyboard",
                "Mouse",
                "Gamepad"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Physical device measured for this control; null on records from the keyboard-only snapshot",
          "title": "Device"
        },
        "holds": {
          "items": {
            "$ref": "#/$defs/HoldMeasurement"
          },
          "title": "Holds",
          "type": "array"
        },
        "inverted_relative_to_entity_basis": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "title": "Inverted Relative To Entity Basis"
        },
        "lowest_tested_effective_requested_hold_s": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Lowest Tested Effective Requested Hold S"
        },
        "minimum_hold_scope": {
          "title": "Minimum Hold Scope",
          "type": "string"
        },
        "resolution": {
          "title": "Resolution",
          "type": "string"
        },
        "sensitivity": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Measured response slope, or null when not measured",
          "title": "Sensitivity"
        },
        "sensitivity_reason": {
          "default": "sensitivity is unknown: one declared value per control was measured, not a response curve",
          "title": "Sensitivity Reason",
          "type": "string"
        },
        "shortest_observed_effective_hold_s": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Shortest Observed Effective Hold S"
        },
        "signed_basis_projections": {
          "items": {
            "type": "number"
          },
          "title": "Signed Basis Projections",
          "type": "array"
        }
      },
      "required": [
        "control",
        "bindings",
        "resolution",
        "holds",
        "lowest_tested_effective_requested_hold_s",
        "shortest_observed_effective_hold_s",
        "minimum_hold_scope",
        "inverted_relative_to_entity_basis",
        "signed_basis_projections",
        "dead_zone",
        "dead_zone_reason"
      ],
      "title": "ActionCalibration",
      "type": "object"
    },
    "ActionDefinition": {
      "additionalProperties": false,
      "description": "One action (inputs + default_lease_s) or one skill (steps + max_s), never both.",
      "properties": {
        "backend": {
          "const": "input_system",
          "title": "Backend",
          "type": "string"
        },
        "default_lease_s": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "maximum": 3600.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Declared hold and lease for this action; the measured applied duration is reported separately",
          "title": "Default Lease S"
        },
        "inputs": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/InputBinding"
              },
              "maxItems": 3,
              "minItems": 1,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Controls held together for one action",
          "title": "Inputs"
        },
        "max_s": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "maximum": 3600.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Upper bound on the whole skill, including waits",
          "title": "Max S"
        },
        "steps": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/ActionStep"
              },
              "maxItems": 8,
              "minItems": 1,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Ordered bounded skill steps",
          "title": "Steps"
        }
      },
      "required": [
        "backend"
      ],
      "title": "ActionDefinition",
      "type": "object"
    },
    "ActionStep": {
      "additionalProperties": false,
      "description": "One ordered skill step: hold its inputs, release and verify them, then wait.",
      "properties": {
        "hold_s": {
          "description": "Declared hold in seconds; a tap must be resolved to a tested positive hold",
          "exclusiveMinimum": 0,
          "maximum": 3600.0,
          "title": "Hold S",
          "type": "number"
        },
        "inputs": {
          "description": "Controls held together for this step",
          "items": {
            "$ref": "#/$defs/InputBinding"
          },
          "maxItems": 3,
          "minItems": 1,
          "title": "Inputs",
          "type": "array"
        },
        "wait_s": {
          "description": "Seconds to wait after this step's inputs are released and verified",
          "maximum": 3600.0,
          "minimum": 0,
          "title": "Wait S",
          "type": "number"
        }
      },
      "required": [
        "inputs",
        "hold_s",
        "wait_s"
      ],
      "title": "ActionStep",
      "type": "object"
    },
    "AppliedInput": {
      "additionalProperties": false,
      "description": "One physical input the bridge applied, as measured at apply and release time.\n\n`applied_duration_s` is the measured interval from device apply acknowledgement to\nobserved release. It is never copied from configured hold time. A relative pointer\nimpulse may report a null duration when its neutral-reset instant was not measured,\nbut it always reports the actual pixel delta it produced.",
      "properties": {
        "applied_delta_x": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Actual mouse pixel delta, not a configured value",
          "title": "Applied Delta X"
        },
        "applied_delta_y": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Actual mouse pixel delta, not a configured value",
          "title": "Applied Delta Y"
        },
        "applied_duration_s": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Measured apply-to-release seconds",
          "title": "Applied Duration S"
        },
        "control": {
          "description": "Physical root control, without a device prefix",
          "minLength": 1,
          "title": "Control",
          "type": "string"
        },
        "device": {
          "enum": [
            "Keyboard",
            "Mouse",
            "Gamepad"
          ],
          "title": "Device",
          "type": "string"
        },
        "input_end_wall_s": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Observed release, wall seconds",
          "title": "Input End Wall S"
        },
        "input_start_wall_s": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Device apply acknowledgement, wall seconds",
          "title": "Input Start Wall S"
        },
        "release_verified": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Device-state read confirmed this input is no longer held",
          "title": "Release Verified"
        },
        "step_index": {
          "description": "0 for an action; the ordered step index for a skill",
          "minimum": 0,
          "title": "Step Index",
          "type": "integer"
        },
        "x": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": -1,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Declared normalized value; null for a button",
          "title": "X"
        },
        "y": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": -1,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Declared second value; 0 for a one-dimensional axis; null for a button",
          "title": "Y"
        }
      },
      "required": [
        "step_index",
        "device",
        "control"
      ],
      "title": "AppliedInput",
      "type": "object"
    },
    "Comparator": {
      "enum": [
        "==",
        "!=",
        "<",
        "<=",
        ">",
        ">=",
        "changed",
        "unchanged"
      ],
      "title": "Comparator",
      "type": "string"
    },
    "ExecStatus": {
      "enum": [
        "requested",
        "validated",
        "running",
        "completed",
        "failed",
        "cancelled",
        "timed_out",
        "rejected"
      ],
      "title": "ExecStatus",
      "type": "string"
    },
    "HoldMeasurement": {
      "additionalProperties": false,
      "properties": {
        "effective_in_all_repeats": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "description": "True when every valid repeat's net displacement met the plan's effect tolerance. False is not proof the input had no effect: motion that returns to its start nets to zero",
          "title": "Effective In All Repeats"
        },
        "mean_delta": {
          "anyOf": [
            {
              "maxItems": 3,
              "minItems": 3,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "description": "Mean net entity displacement over the valid trials: the change between the read before the input and the read just after it, minus the idle baseline",
          "title": "Mean Delta"
        },
        "mean_magnitude": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "Mean of each valid trial's net displacement magnitude, with the same net meaning",
          "title": "Mean Magnitude"
        },
        "mean_view_turn": {
          "anyOf": [
            {
              "$ref": "#/$defs/ViewTurn"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Mean change of the game view over the valid trials that measured it, or null when no valid trial did. A view that was not read is unknown, not a turn of zero degrees; null on records from before the view was measured"
        },
        "requested_hold_s": {
          "description": "Probe setting, not the applied duration",
          "exclusiveMinimum": 0,
          "title": "Requested Hold S",
          "type": "number"
        },
        "sample_variance": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "Sample variance of the per-trial net displacement magnitudes",
          "title": "Sample Variance"
        },
        "valid_trials": {
          "minimum": 0,
          "title": "Valid Trials",
          "type": "integer"
        }
      },
      "required": [
        "requested_hold_s",
        "valid_trials",
        "mean_delta",
        "mean_magnitude",
        "sample_variance",
        "effective_in_all_repeats"
      ],
      "title": "HoldMeasurement",
      "type": "object"
    },
    "InputBinding": {
      "additionalProperties": false,
      "description": "One physical input and its declared normalized value.",
      "properties": {
        "control": {
          "maxLength": 40,
          "minLength": 1,
          "title": "Control",
          "type": "string"
        },
        "device": {
          "enum": [
            "Keyboard",
            "Mouse",
            "Gamepad"
          ],
          "title": "Device",
          "type": "string"
        },
        "x": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": -1,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Normalized value in [-1, 1]; null for a button",
          "title": "X"
        },
        "y": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": -1,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Second normalized value; 0 for a one-dimensional axis; null for a button",
          "title": "Y"
        }
      },
      "required": [
        "device",
        "control"
      ],
      "title": "InputBinding",
      "type": "object"
    },
    "InputExecutionEvidence": {
      "additionalProperties": false,
      "description": "Release-verified receipts for one exact declaration, kept as local evidence.\n\nThe declaration itself is recorded here rather than inferred from receipts or a label:\nsupport requires exact inputs, values, holds, waits and `max_s`, before any measured\ntiming allowance. Historical bare evidence without a declaration fails closed. This\nrecord proves only that the bridge completed that declaration and applied/released the\nsame physical inputs; it is not a claim about game effects.",
      "properties": {
        "action": {
          "description": "The action name this execution was requested under",
          "minLength": 1,
          "title": "Action",
          "type": "string"
        },
        "applied_duration_s": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Applied Duration S"
        },
        "declaration": {
          "$ref": "#/$defs/ActionDefinition",
          "description": "The exact requested declaration this evidence proves; required, never guessed"
        },
        "input_end_wall_s": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Input End Wall S"
        },
        "input_start_wall_s": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Input Start Wall S"
        },
        "receipts": {
          "items": {
            "$ref": "#/$defs/AppliedInput"
          },
          "title": "Receipts",
          "type": "array"
        },
        "release_verified": {
          "title": "Release Verified",
          "type": "boolean"
        },
        "session": {
          "minLength": 1,
          "title": "Session",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/ExecStatus"
        },
        "wall_utc": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Wall Utc"
        }
      },
      "required": [
        "action",
        "session",
        "status",
        "release_verified",
        "declaration"
      ],
      "title": "InputExecutionEvidence",
      "type": "object"
    },
    "InspectionCap": {
      "additionalProperties": false,
      "description": "How completely one collection was sampled.\n\nAn uncounted total stays null; it is never guessed from the returned sample. A known\nobserved count must agree with `truncated`: true means some items were left out, false\nmeans the returned sample is the whole collection.",
      "properties": {
        "limit": {
          "exclusiveMinimum": 0,
          "title": "Limit",
          "type": "integer"
        },
        "observed": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "description": "Items seen, or null when the total is unknown",
          "title": "Observed"
        },
        "returned": {
          "minimum": 0,
          "title": "Returned",
          "type": "integer"
        },
        "truncated": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "description": "Whether the sample was capped, or null when unknown",
          "title": "Truncated"
        }
      },
      "required": [
        "limit",
        "observed",
        "returned",
        "truncated"
      ],
      "title": "InspectionCap",
      "type": "object"
    },
    "ManifestAction": {
      "additionalProperties": false,
      "properties": {
        "axis": {
          "title": "Axis",
          "type": "boolean"
        },
        "calibrations": {
          "items": {
            "$ref": "#/$defs/ActionCalibration"
          },
          "maxItems": 3,
          "minItems": 1,
          "title": "Calibrations",
          "type": "array"
        },
        "execution_evidence": {
          "anyOf": [
            {
              "$ref": "#/$defs/InputExecutionEvidence"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Release-verified receipts for this exact declaration, or null when unproven"
        },
        "execution_supported": {
          "description": "True only when execution_evidence completed with verified release for this exact declaration",
          "title": "Execution Supported",
          "type": "boolean"
        },
        "hold_effect": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "description": "Entity-displacement response in repeated trials for the exact input value and hold, or null if not established",
          "title": "Hold Effect"
        },
        "hold_s": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "maximum": 3600,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Hold S"
        },
        "inputs": {
          "items": {
            "$ref": "#/$defs/ManifestInput"
          },
          "maxItems": 3,
          "minItems": 1,
          "title": "Inputs",
          "type": "array"
        },
        "intent": {
          "minLength": 1,
          "title": "Intent",
          "type": "string"
        },
        "max_hold_s": {
          "description": "No per-action override limit has been measured",
          "title": "Max Hold S",
          "type": "null"
        },
        "name": {
          "pattern": "^[a-z][a-z0-9_]{0,39}$",
          "title": "Name",
          "type": "string"
        },
        "preconditions": {
          "items": {
            "$ref": "#/$defs/ManifestCheck"
          },
          "maxItems": 3,
          "title": "Preconditions",
          "type": "array"
        },
        "tap_hold_s": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "maximum": 3600,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "Tested requested hold, not observed applied duration",
          "title": "Tap Hold S"
        }
      },
      "required": [
        "name",
        "intent",
        "inputs",
        "hold_s",
        "tap_hold_s",
        "preconditions",
        "calibrations",
        "axis",
        "max_hold_s",
        "hold_effect",
        "execution_supported"
      ],
      "title": "ManifestAction",
      "type": "object"
    },
    "ManifestCheck": {
      "additionalProperties": false,
      "properties": {
        "field": {
          "pattern": "^[a-z][a-z0-9_]{0,39}$",
          "title": "Field",
          "type": "string"
        },
        "op": {
          "$ref": "#/$defs/Comparator"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "string"
            },
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "field",
        "op",
        "value"
      ],
      "title": "ManifestCheck",
      "type": "object"
    },
    "ManifestGaps": {
      "additionalProperties": false,
      "properties": {
        "coverage": {
          "items": {
            "type": "string"
          },
          "title": "Coverage",
          "type": "array"
        },
        "scope": {
          "const": "model_report_relative_to_offered_and_selected_evidence",
          "title": "Scope",
          "type": "string"
        },
        "uncontrollable": {
          "description": "Model-reported gaps; harness limitations are recorded separately",
          "items": {
            "type": "string"
          },
          "maxItems": 8,
          "title": "Uncontrollable",
          "type": "array"
        },
        "unjudgeable": {
          "description": "Model-reported gaps relative to the selected readers",
          "items": {
            "type": "string"
          },
          "maxItems": 8,
          "title": "Unjudgeable",
          "type": "array"
        },
        "unobservable": {
          "description": "Model-reported gaps relative to the offered and selected evidence",
          "items": {
            "type": "string"
          },
          "maxItems": 8,
          "title": "Unobservable",
          "type": "array"
        }
      },
      "required": [
        "scope",
        "unobservable",
        "uncontrollable",
        "unjudgeable",
        "coverage"
      ],
      "title": "ManifestGaps",
      "type": "object"
    },
    "ManifestImage": {
      "additionalProperties": false,
      "properties": {
        "bytes": {
          "exclusiveMinimum": 0,
          "title": "Bytes",
          "type": "integer"
        },
        "capture_game_s": {
