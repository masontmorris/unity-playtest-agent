        "reader_cap_reached",
        "action_cap",
        "action_cap_reached",
        "skill_cap",
        "skill_cap_reached",
        "gap_caps_reached"
      ],
      "title": "SelectionCoverage",
      "type": "object"
    },
    "ViewTurn": {
      "additionalProperties": false,
      "description": "How far the game view turned: the mean change between the view read just before an input and\nthe read just after it, over the valid trials that measured it both times.\n\nYaw is wrapped to [-180, 180) per trial before averaging, so a turn across the +/-180 degree seam\nis a small change, not a near-full circle. A positive yaw turns right and a positive pitch looks down.\nThe same wrap means a turn of 180 degrees or more in one apply cannot be read from two readings: it\nshows as a smaller turn, and repeats that differ by a little then differ by a lot. `spread_deg` is how\nfar the trials disagree, so a mean that cannot be trusted says so.",
      "properties": {
        "pitch_deg": {
          "description": "Mean pitch change",
          "maximum": 180,
          "minimum": -180,
          "title": "Pitch Deg",
          "type": "number"
        },
        "spread_deg": {
          "description": "The largest difference between any two of these trials' changes, along yaw or pitch, in degrees; 0 for a single trial, which cannot show whether the turn repeats",
          "minimum": 0,
          "title": "Spread Deg",
          "type": "number"
        },
        "trials": {
          "description": "Valid trials that read the view before and after the input",
          "minimum": 1,
          "title": "Trials",
          "type": "integer"
        },
        "yaw_deg": {
          "description": "Mean yaw change",
          "maximum": 180,
          "minimum": -180,
          "title": "Yaw Deg",
          "type": "number"
        }
      },
      "required": [
        "trials",
        "yaw_deg",
        "pitch_deg",
        "spread_deg"
      ],
      "title": "ViewTurn",
      "type": "object"
    }
  },
  "$id": "upa/preflight_manifest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "actions": {
      "items": {
        "$ref": "#/$defs/ManifestAction"
      },
      "maxItems": 18,
      "title": "Actions",
      "type": "array"
    },
    "discovery_caps": {
      "additionalProperties": {
        "$ref": "#/$defs/InspectionCap"
      },
      "title": "Discovery Caps",
      "type": "object"
    },
    "entity": {
      "additionalProperties": true,
      "title": "Entity",
      "type": "object"
    },
    "entity_id": {
      "minLength": 1,
      "title": "Entity Id",
      "type": "string"
    },
    "gaps": {
      "$ref": "#/$defs/ManifestGaps"
    },
    "image": {
      "anyOf": [
        {
          "$ref": "#/$defs/ManifestImage"
        },
        {
          "type": "null"
        }
      ]
    },
    "invariants": {
      "items": {
        "$ref": "#/$defs/ManifestInvariant"
      },
      "maxItems": 12,
      "title": "Invariants",
      "type": "array"
    },
    "inventory_caps": {
      "additionalProperties": {
        "$ref": "#/$defs/InspectionCap"
      },
      "title": "Inventory Caps",
      "type": "object"
    },
    "packet_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Packet Sha256",
      "type": "string"
    },
    "progress": {
      "items": {
        "$ref": "#/$defs/ManifestProgress"
      },
      "maxItems": 6,
      "title": "Progress",
      "type": "array"
    },
    "reach_regions": {
      "items": {
        "$ref": "#/$defs/ReachRegion"
      },
      "maxItems": 8,
      "title": "Reach Regions",
      "type": "array"
    },
    "readers": {
      "items": {
        "$ref": "#/$defs/ManifestReader"
      },
      "maxItems": 16,
      "title": "Readers",
      "type": "array"
    },
    "reset_bindings": {
      "title": "Reset Bindings",
      "type": "null"
    },
    "reset_bindings_reason": {
      "minLength": 1,
      "title": "Reset Bindings Reason",
      "type": "string"
    },
    "schema_version": {
      "const": 2,
      "title": "Schema Version",
      "type": "integer"
    },
    "selection": {
      "$ref": "#/$defs/SelectionCoverage"
    },
    "skills": {
      "items": {
        "$ref": "#/$defs/ManifestSkill"
      },
      "maxItems": 6,
      "title": "Skills",
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "packet_sha256",
    "entity_id",
    "entity",
    "inventory_caps",
    "discovery_caps",
    "image",
    "readers",
    "actions",
    "skills",
    "progress",
    "invariants",
    "gaps",
    "selection",
    "reset_bindings",
    "reset_bindings_reason"
  ],
  "title": "PreflightManifest",
  "type": "object"
}
