{
  "$defs": {
    "Contingent": {
      "additionalProperties": false,
      "description": "S1's own answers to the batched conditional questions, made in the same request as its primary choice.\n\nEach field is a choice id from the same `set_version`, or null when S1 gave no answer for that branch.\nA branch is what S1 selected for that outcome when it answered, so executing it once its condition has\nmeasurably occurred is adherence, not substitution; a null branch is never filled in by code.",
      "properties": {
        "if_blocked": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "If Blocked"
        },
        "if_succeeded": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "If Succeeded"
        }
      },
      "title": "Contingent",
      "type": "object"
    },
    "WhilePending": {
      "additionalProperties": false,
      "properties": {
        "choice_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Choice Id"
        },
        "mode": {
          "enum": [
            "wait",
            "continue"
          ],
          "title": "Mode",
          "type": "string"
        }
      },
      "required": [
        "mode"
      ],
      "title": "WhilePending",
      "type": "object"
    }
  },
  "$id": "upa/decision.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "S1's answer. `distribution` is recorded for analysis and never used to select.",
  "properties": {
    "choice_id": {
      "minLength": 1,
      "title": "Choice Id",
      "type": "string"
    },
    "contingent": {
      "anyOf": [
        {
          "$ref": "#/$defs/Contingent"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "distribution": {
      "anyOf": [
        {
          "additionalProperties": {
            "type": "number"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Distribution"
    },
    "reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reason"
    },
    "set_version": {
      "minimum": 0,
      "title": "Set Version",
      "type": "integer"
    },
    "while_pending": {
      "anyOf": [
        {
          "$ref": "#/$defs/WhilePending"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "choice_id",
    "set_version"
  ],
  "title": "Decision",
  "type": "object"
}
