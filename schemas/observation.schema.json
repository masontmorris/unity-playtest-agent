{
  "$defs": {
    "ClockMode": {
      "enum": [
        "realtime",
        "stepped"
      ],
      "title": "ClockMode",
      "type": "string"
    },
    "ReaderError": {
      "additionalProperties": false,
      "properties": {
        "error": {
          "title": "Error",
          "type": "string"
        },
        "reader": {
          "title": "Reader",
          "type": "string"
        }
      },
      "required": [
        "reader",
        "error"
      ],
      "title": "ReaderError",
      "type": "object"
    },
    "ViewAngles": {
      "additionalProperties": false,
      "description": "Where the game-view camera points in world space, in degrees: an engine fact, not a game field.\n\nBoth come from the camera's forward vector, so they are measured together. Yaw is the heading,\natan2(forward.x, forward.z), and a positive change turns right. Pitch is asin(-forward.y), and a\npositive change looks down, as Unity's own euler x does. A reading is a direction, not a turn: a\nturn is the difference of two readings, with yaw wrapped to [-180, 180).",
      "properties": {
        "pitch_deg": {
          "maximum": 90,
          "minimum": -90,
          "title": "Pitch Deg",
          "type": "number"
        },
        "yaw_deg": {
          "maximum": 180,
          "minimum": -180,
          "title": "Yaw Deg",
          "type": "number"
        }
      },
      "required": [
        "yaw_deg",
        "pitch_deg"
      ],
      "title": "ViewAngles",
      "type": "object"
    }
  },
  "$id": "upa/observation.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "One sample of the game. Missing readers are null plus a reader_errors entry.",
  "properties": {
    "clock_mode": {
      "$ref": "#/$defs/ClockMode"
    },
    "frame": {
      "minimum": 0,
      "title": "Frame",
      "type": "integer"
    },
    "frame_ref": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Frame Ref"
    },
    "game_s": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Game clock; null when no game is running",
      "title": "Game S"
    },
    "paused": {
      "title": "Paused",
      "type": "boolean"
    },
    "playing": {
      "title": "Playing",
      "type": "boolean"
    },
    "protocol": {
      "default": "upa/1",
      "pattern": "^upa/\\d+$",
      "title": "Protocol",
      "type": "string"
    },
    "public": {
      "additionalProperties": true,
      "title": "Public",
      "type": "object"
    },
    "reader_errors": {
      "items": {
        "$ref": "#/$defs/ReaderError"
      },
      "title": "Reader Errors",
      "type": "array"
    },
    "scene": {
      "title": "Scene",
      "type": "string"
    },
    "seq": {
      "minimum": 0,
      "title": "Seq",
      "type": "integer"
    },
    "session": {
      "minLength": 1,
      "title": "Session",
      "type": "string"
    },
    "time_scale": {
      "minimum": 0,
      "title": "Time Scale",
      "type": "number"
    },
    "type": {
      "const": "observation",
      "default": "observation",
      "title": "Type",
      "type": "string"
    },
    "ui": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Ui"
    },
    "view": {
      "anyOf": [
        {
          "$ref": "#/$defs/ViewAngles"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "The game-view camera's world yaw and pitch, or null when the bridge has no such camera. Null is unknown, never a heading of zero"
    },
    "wall_utc": {
      "format": "date-time",
      "title": "Wall Utc",
      "type": "string"
    }
  },
  "required": [
    "session",
    "seq",
    "wall_utc",
    "clock_mode",
    "scene",
    "playing",
    "paused",
    "time_scale",
    "frame"
  ],
  "title": "Observation",
  "type": "object"
}
