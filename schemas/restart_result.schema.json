{
  "$defs": {
    "RestartPhase": {
      "enum": [
        "accepted",
        "stopped",
        "starting",
        "ready",
        "failed",
        "cancelled"
      ],
      "title": "RestartPhase",
      "type": "string"
    }
  },
  "$id": "upa/restart_result.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "`result.json`: the host's one terminal record for one ticket. It does not attest the handshake.",
  "properties": {
    "entered_edit_mode_utc": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Entered Edit Mode Utc"
    },
    "entered_play_mode_utc": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Entered Play Mode Utc"
    },
    "failure_reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Failure Reason"
    },
    "from_generation": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "title": "From Generation",
      "type": "string"
    },
    "phase": {
      "$ref": "#/$defs/RestartPhase"
    },
    "ready_utc": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Ready Utc"
    },
    "run_id": {
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    },
    "scene_handle": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Scene Handle"
    },
    "scene_path": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Scene Path"
    },
    "ticket_id": {
      "minLength": 1,
      "title": "Ticket Id",
      "type": "string"
    },
    "to_generation": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "To Generation"
    },
    "version": {
      "const": 1,
      "title": "Version",
      "type": "integer"
    }
  },
  "required": [
    "version",
    "run_id",
    "ticket_id",
    "phase",
    "from_generation"
  ],
  "title": "RestartResult",
  "type": "object"
}
