{
  "$defs": {
    "ClockMode": {
      "enum": [
        "realtime",
        "stepped"
      ],
      "title": "ClockMode",
      "type": "string"
    },
    "Comparator": {
      "enum": [
        "==",
        "!=",
        "<",
        "<=",
        ">",
        ">=",
        "changed",
        "unchanged"
      ],
      "title": "Comparator",
      "type": "string"
    },
    "ExpectedSource": {
      "enum": [
        "invariant",
        "objective",
        "developer_assertion",
        "interpretation"
      ],
      "title": "ExpectedSource",
      "type": "string"
    },
    "FindingState": {
      "enum": [
        "suspicion",
        "candidate",
        "repro_attempted",
        "reproduced",
        "unconfirmed",
        "fix_proposed",
        "fix_verified"
      ],
      "title": "FindingState",
      "type": "string"
    },
    "Repro": {
      "additionalProperties": false,
      "properties": {
        "attempts": {
          "minimum": 0,
          "title": "Attempts",
          "type": "integer"
        },
        "clock_mode": {
          "$ref": "#/$defs/ClockMode"
        },
        "reproduced": {
          "minimum": 0,
          "title": "Reproduced",
          "type": "integer"
        },
        "reset": {
          "minLength": 1,
          "title": "Reset",
          "type": "string"
        },
        "tolerance": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tolerance"
        }
      },
      "required": [
        "attempts",
        "reproduced",
        "clock_mode",
        "reset"
      ],
      "title": "Repro",
      "type": "object"
    },
    "ReproCheck": {
      "additionalProperties": false,
      "description": "What a replay must show to reproduce a finding: one field, one comparator, one value.\n\nA reader field (`public.<reader>`) is scored with the shared check evaluator against the readers a replay\nreads. `changed` and `unchanged` take no value and compare with the reading when the replay starts.\n\n`effect.<action>` is the net displacement, in world units, of one execution of that action, measured between\ntwo position snapshots. It shows an action that stops having its effect, which leaves the readers as they are\nat rest. It takes `<`, `<=`, `>` or `>=` and a finite number, and no tolerance; the other comparators have\nnothing to compare a displacement with.",
      "properties": {
        "field": {
          "description": "Dotted path into the observation, e.g. public.<reader>; or effect.<action>, the net displacement of one execution of an action",
          "minLength": 1,
          "title": "Field",
          "type": "string"
        },
        "op": {
          "$ref": "#/$defs/Comparator"
        },
        "tolerance": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Only for numeric == or !=",
          "title": "Tolerance"
        },
        "value": {
          "default": null,
          "title": "Value"
        }
      },
      "required": [
        "field",
        "op"
      ],
      "title": "ReproCheck",
      "type": "object"
    }
  },
  "$id": "upa/finding.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "actual": {
      "title": "Actual",
      "type": "string"
    },
    "clips": {
      "items": {
        "type": "string"
      },
      "title": "Clips",
      "type": "array"
    },
    "conditions": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Conditions"
    },
    "evidence_seq": {
      "items": {
        "type": "integer"
      },
      "title": "Evidence Seq",
      "type": "array"
    },
    "expected": {
      "title": "Expected",
      "type": "string"
    },
    "expected_source": {
      "$ref": "#/$defs/ExpectedSource"
    },
    "finding_id": {
      "minLength": 1,
      "title": "Finding Id",
      "type": "string"
    },
    "repro": {
      "anyOf": [
        {
          "$ref": "#/$defs/Repro"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "repro_check": {
      "anyOf": [
        {
          "$ref": "#/$defs/ReproCheck"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "What a replay must show; null when none was given"
    },
    "severity": {
      "anyOf": [
        {
          "enum": [
            "blocker",
            "major",
            "minor",
            "cosmetic",
            "unknown"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Severity"
    },
    "severity_reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Severity Reason"
    },
    "state": {
      "$ref": "#/$defs/FindingState"
    },
    "steps": {
      "items": {
        "type": "string"
      },
      "title": "Steps",
      "type": "array"
    },
    "title": {
      "minLength": 1,
      "title": "Title",
      "type": "string"
    },
    "uncertainty": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Uncertainty"
    }
  },
  "required": [
    "finding_id",
    "state",
    "title",
    "expected",
    "expected_source",
    "actual"
  ],
  "title": "Finding",
  "type": "object"
}
